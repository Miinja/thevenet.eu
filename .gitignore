# ─────────────────────────────────────────────
# .gitignore — thevenet.eu (site statique GitHub Pages)
# ─────────────────────────────────────────────

# Secrets et configuration privée (ne jamais versionner)
inc/config.php
.env
.env.*
*.key
*.pem
*.p12
secrets/

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp
*~

# Brouillons, sauvegardes et journaux
*.bak
*.tmp
*.log

# Lanceur local (non publié)
ouvrir-en-local.bat
